<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration for ScreenReaderAccessibilityService.
  We deliberately listen to a narrow set of event types (window changes) rather than every
  possible accessibility event, since we re-read the whole node tree ourselves on each
  window change rather than tracking incremental UI mutations - this keeps the MVP simple
  and matches the "summarize on app switch" acceptance criterion.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackSpoken"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="300"
    android:settingsActivity="com.klarl.accessibility.ui.MainActivity" />
