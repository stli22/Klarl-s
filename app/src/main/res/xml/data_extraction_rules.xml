<?xml version="1.0" encoding="utf-8"?>
<!-- Backups are disabled (allowBackup=false) so this file exists only to satisfy the
     dataExtractionRules manifest attribute; it excludes everything defensively. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapability="true">
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
